{% comment %}
  Product information row using Dawn's native details/summary component.
  Accepts: block, section_id, heading, content, icon.
  Empty content is hidden from shoppers; the editor shows setup guidance.
{% endcomment %}
{%- if content != blank or request.design_mode -%}
  <div class="product__accordion accordion quick-add-hidden" {{ block.shopify_attributes }}>
    <details id="Details-{{ block.id }}-{{ section_id }}">
      <summary>
        <div class="summary__title">
          {% render 'icon-accordion', icon: icon %}
          <h2 class="h4 accordion__title inline-richtext">{{ heading | escape }}</h2>
        </div>
        {{- 'icon-caret.svg' | inline_asset_content -}}
      </summary>
      <div class="accordion__content rte" id="ProductAccordion-{{ block.id }}-{{ section_id }}">
        {%- if content != blank -%}
          {{ content }}
        {%- elsif request.design_mode -%}
          <p>Add the selected store policy in Shopify settings, or enter custom content in this block.</p>
        {%- endif -%}
      </div>
    </details>
  </div>
{%- endif -%}
